# ASZEN Platform Production Environment Variables
# Copy this file to .env on your Hostinger server

SECRET_KEY=aszen-production-secret-key-replace-with-random-string
JWT_SECRET=aszen-production-jwt-secret-replace-with-random-string
JWT_EXPIRY_HOURS=8760

# Hostinger MySQL Database Connection String
# Format: mysql+pymysql://<db_user>:<db_password>@localhost/<db_name>
DATABASE_URL=mysql+pymysql://u123456789_aszen_user:YourStrongPassword123@localhost/u123456789_aszen_db

# Frontend Domain URL
FRONTEND_URL=https://vistaeditz.com

# SMTP Mail Settings (Hostinger Email / Gmail SMTP)
MAIL_SERVER=smtp.hostinger.com
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_USERNAME=contact@vistaeditz.com
MAIL_PASSWORD=YourEmailPassword123
MAIL_DEFAULT_SENDER=contact@vistaeditz.com
